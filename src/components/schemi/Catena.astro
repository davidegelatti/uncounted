---
import { traduttore, type Lingua } from '../../i18n/indice';
const { lingua } = Astro.props as { lingua: Lingua };
const t = traduttore(lingua);
---
<figure><svg class="schema" viewBox="0 0 780 150" role="img" aria-label={t('schema.catenaAria')}>
  <rect class="s-oss" x="4" y="20" width="160" height="56" rx="10"/><text class="forte" x="84" y="44" text-anchor="middle">{t('schema.sessioniOsservate')}</text><text class="s2" x="84" y="62" text-anchor="middle">{t('schema.dalFile')}</text>
  <text x="182" y="54" text-anchor="middle">×</text>
  <rect class="s-viola" x="200" y="20" width="170" height="56" rx="10"/><text class="forte" x="285" y="44" text-anchor="middle">{t('schema.rifiutiAccettazioni')}</text><text class="s2" x="285" y="62" text-anchor="middle">{t('schema.dalTasso')}</text>
  <text x="388" y="54" text-anchor="middle">×</text>
  <rect class="s-ambra" x="406" y="20" width="160" height="56" rx="10"/><text class="forte" x="486" y="44" text-anchor="middle">{t('schema.quanteVolteTorna')}</text><text class="s2" x="486" y="62" text-anchor="middle">{t('schema.ipotesi')}</text>
  <text x="584" y="54" text-anchor="middle">=</text>
  <rect class="s-blu" x="602" y="20" width="174" height="56" rx="10"/><text class="forte" x="689" y="44" text-anchor="middle">{t('schema.sessioniPerse')}</text><text class="s2" x="689" y="62" text-anchor="middle">{t('schema.stima')}</text>
  <path class="s-linea" d="M689 78v20"/>
  <text x="776" y="118" text-anchor="end">{t('schema.perConversione')}</text>
  <text class="forte" x="776" y="138" text-anchor="end">{t('schema.conversioniPerse')}</text>
</svg></figure>
